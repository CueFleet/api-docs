  "components": {
    "securitySchemes": {
      "LocalKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "ef1_<random base64url>"
      }
    },
    "schemas": {
      "Envelope": {
        "type": "object",
        "required": [
          "ok",
          "traceId"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "data": {},
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              }
            }
          },
          "traceId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Order": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "direction",
          "amount",
          "period",
          "payoutRatio"
        ],
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid",
            "description": "Optional authorized account UUID. Omit for automatic routing using the configured single/dual mode and balanced/sequential strategy. Retries stay on the original account."
          },
          "symbol": {
            "type": "string",
            "enum": [
              "ETHUSDT",
              "BTCUSDT"
            ]
          },
          "direction": {
            "type": "string",
            "enum": [
              "LONG",
              "SHORT"
            ]
          },
          "amount": {
            "type": "string",
            "pattern": "^\\d{1,24}(\\.\\d{1,18})?$",
            "description": "Positive amount satisfying current market limits and local cap."
          },
          "period": {
            "type": "string",
            "enum": [
              "10m",
              "30m",
              "1h",
              "1d"
            ]
          },
          "wallet": {
            "type": "string",
            "enum": [
              "UM"
            ],
            "default": "UM",
            "description": "USD-M wallet only. Defaults to UM when omitted."
          },
          "payoutRatio": {
            "type": "string",
            "pattern": "^\\d{1,24}(\\.\\d{1,18})?$",
            "description": "Current payout ratio for the exact symbol, period and direction, read from market."
          }
        }
      }
    }
  }
}
